# ---------------------------------------------------------
# SV Wacker Burghausen eSports — Umgebungsvariablen
# Kopiere diese Datei zu ".env" und passe die Werte an.
# ---------------------------------------------------------

# Datenbank
# Lokal/Standard: SQLite, keine Installation nötig.
DATABASE_URL="file:./dev.db"

# Für Produktion (Vercel + Supabase/Neon/Railway Postgres), z.B.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# WICHTIG: Beim Wechsel auf Postgres in prisma/schema.prisma den
# datasource-provider von "sqlite" auf "postgresql" ändern (siehe README).

# NextAuth
# Geheimer Schlüssel zum Signieren der Sessions. Erzeuge einen eigenen mit:
#   openssl rand -base64 32
NEXTAUTH_SECRET="bitte-mit-openssl-rand-base64-32-ersetzen"

# Die öffentliche URL der App (lokal: http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------
# Erster Zugang (wird von "npm run db:seed" verwendet)
# Legt EINEN Manager-Zugang an, der Kader startet komplett leer.
# Ohne diese Variablen wird ersatzweise manager@wacker-esports.de /
# Manager2026! angelegt — bitte danach unbedingt eigene Werte setzen
# und das Passwort nach dem ersten Login sofort ändern.
# ---------------------------------------------------------
INITIAL_MANAGER_NAME="Dein Name"
INITIAL_MANAGER_EMAIL="dein.name@example.com"
INITIAL_MANAGER_PASSWORD="bitte-sicheres-passwort-setzen"

# ---------------------------------------------------------
# Discord-Integration (optional)
# Ohne diese Variablen läuft die App ganz normal weiter — die
# Discord-Funktionen blenden sich einfach aus / liefern eine
# verständliche Fehlermeldung. Einrichtung siehe README → "Discord-Integration".
# ---------------------------------------------------------

# 1) Einfache Ankündigungen (neuer Spieltag, Aufstellung veröffentlicht, Taktik
#    aktualisiert, Ergebnis eingetragen) — nur eine Webhook-URL aus deinem
#    Discord-Kanal (Kanal-Einstellungen → Integrationen → Webhooks → Neuer Webhook).
DISCORD_WEBHOOK_URL=""

# 2) Zu-/Absage per Button direkt in Discord — dafür wird eine echte Discord-App
#    mit Bot benötigt (siehe README für die genauen Schritte im Developer Portal).
DISCORD_BOT_TOKEN=""
DISCORD_APPLICATION_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_CHANNEL_ID=""
